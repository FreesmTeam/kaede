{
  "name": "kaede",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "dev:frontend": "vite",
    "build:frontend": "vue-tsc -b && vite build",
    "build:hmr": "NODE_ENV=development tauri build",
    "preview:frontend": "vite preview",
    "test": "bun test --preload ./bun.setup.ts src",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "generate:validators": "bun scripts/generate-validators.ts",
    "generate:bundle-analysis": "bunx vite build --sourcemap && bunx source-map-explorer 'dist/assets/*.js' --html bundle-analysis.html --no-border-checks",
    "generate:types": "dts-bundle-generator ./src/declarations.ts -o ./types/kaede-lib.d.ts --project tsconfig.types.json --inline-declare-global"
  },
  "dependencies": {
    "@daidr/minecraft-skin-renderer": "^0.3.2",
    "@fabianlars/tauri-plugin-oauth": "2",
    "@tanstack/vue-query": "^5.90.7",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-log": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "~2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-upload": "~2",
    "@vueuse/core": "^14.0.0",
    "ark-of-atrahasis": "^0.3.1",
    "dompurify": "^3.4.13",
    "m3ripple-vue": "^0.1.0",
    "marked": "^18.0.9",
    "prism-code-editor": "^5.2.0",
    "serialize-javascript": "^7.0.7",
    "ses": "^1.14.0",
    "typebox": "^1.0.8",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.34.0",
    "@iconify-json/lucide": "^1.2.70",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@tauri-apps/cli": "^2.8.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.3.0",
    "@types/serialize-javascript": "^5.0.4",
    "@types/unzipper": "^0.10.11",
    "@unocss/eslint-config": "^66.4.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue-require-id/eslint-plugin": "^1.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "ajv": "^8.18.0",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.34.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "unocss": "^66.4.2",
    "vite": "^7.0.4",
    "vite-plugin-eslint2": "^5.0.4",
    "vue-tsc": "^2.2.12"
  }
}
