{
  "name": "kaede",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "dev:frontend": "vite",
    "build:frontend": "vue-tsc -b && vite build",
    "preview:frontend": "vite preview",
    "test": "vitest run ./src",
    "test:tauri-acl": "cargo test --manifest-path src-tauri/Cargo.toml --locked ipc_acl_smoke::obtained_main_window_is_confined_to_broker_acl -- --exact --nocapture",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "generate:validators": "bun scripts/generate-validators.ts",
    "check:dependency-compatibility": "bun ./scripts/check-dependency-compatibility.ts",
    "generate:types": "bun ./scripts/generate-types.ts",
    "check:types": "bun run generate:types --check && bun ./scripts/check-type-consumers.ts"
  },
  "dependencies": {
    "@daidr/minecraft-skin-renderer": "^0.3.2",
    "@tanstack/vue-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@unocss/reset": "^66.7.5",
    "@vueuse/core": "^14.3.0",
    "ark-of-atrahasis": "github:Vantrongs/ark-of-atrahasis#928f1f3",
    "jshashes": "^1.0.8",
    "m3ripple-vue": "^0.1.0",
    "prism-code-editor": "^5.2.0",
    "serialize-javascript": "^7.0.7",
    "ses": "^1.15.0",
    "typebox": "1.0.22",
    "vue": "^3.5.40",
    "vue-virtualised": "^0.1.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@iconify-json/lucide": "^1.2.119",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/serialize-javascript": "^5.0.4",
    "@unocss/eslint-config": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "typescript": "~5.8.3",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
    "minimatch@9.0.9": "patches/minimatch@9.0.9.patch"
  }
}
